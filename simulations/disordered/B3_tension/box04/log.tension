unfix           eq

# ---- tension ----
reset_timestep  0

variable        tmp equal lx
variable        Lx0 equal ${tmp}
variable        Lx0 equal 41.0391068786993
variable        tmp equal ly
variable        Ly0 equal ${tmp}
variable        Ly0 equal 40.6213546891383
variable        tmp equal lz
variable        Lz0 equal ${tmp}
variable        Lz0 equal 42.2275315774953

variable        strain equal (lx-v_Lx0)/v_Lx0
variable        eyy equal (ly-v_Ly0)/v_Ly0
variable        ezz equal (lz-v_Lz0)/v_Lz0
variable        sxx equal -pxx/10000
variable        syy equal -pyy/10000
variable        szz equal -pzz/10000
variable        natoms equal atoms
variable        pea equal pe/v_natoms
variable        T equal temp

fix             1 all npt temp 300.0 300.0 0.1 y 0.0 0.0 1.0 z 0.0 0.0 1.0
fix             2 all deform 1 x erate 0.01 units box remap x

# averages over 20 steps
fix             ss all ave/time 10 2 20 v_strain v_sxx v_syy v_szz v_eyy v_ezz v_pea v_T                 file stress_strain.txt title2 "# step strain sxx(GPa) syy(GPa) szz(GPa) eyy ezz pe/atom(eV) T(K)"

# snapshots for OVITO (uncomment if needed)
# dump          snap all custom 1000 dump.tension.* id type x y z
# dump_modify   snap sort id

run             15000
