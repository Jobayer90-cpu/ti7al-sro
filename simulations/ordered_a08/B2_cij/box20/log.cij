# stress = -pressure, so C(i,d) = -(p_i(+) - p_i(-)) / (2 * up)
variable        c1 equal -(${q1}-${m1})/(2*${up})*${cfac}
variable        c1 equal -(-26.6157048558036-${m1})/(2*${up})*${cfac}
variable        c1 equal -(-26.6157048558036--27.1607845620647)/(2*${up})*${cfac}
