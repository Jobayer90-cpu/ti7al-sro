variable        cfac equal 1.0e-4          # bar -> GPa

shell           rm -f cij_raw.txt

# ---- reference state: atoms and box relaxed at 0 K ----
units           metal
dimension       3
boundary        p p p
atom_style      atomic

read_data       relaxed.data
